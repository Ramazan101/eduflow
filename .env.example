# Local judging / demo stack only. Copy to .env (gitignored) and fill secrets.
# ./scripts/prepare-env.sh does that without overwriting an existing .env.
# This is not a production configuration.

POSTGRES_USER=eduflow
POSTGRES_PASSWORD=
POSTGRES_DB=eduflow

SECRET_KEY=
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ACCESS_TOKEN_EXPIRE_MINUTES=60

NEXT_PUBLIC_API_URL=http://localhost:8000

# Used only by `python -m app.bootstrap` / ./scripts/demo-init.sh — never read at API startup.
BOOTSTRAP_ADMIN_EMAIL=registrar@example.edu
BOOTSTRAP_ADMIN_PASSWORD=
ALLOW_ADMIN_BOOTSTRAP=false
